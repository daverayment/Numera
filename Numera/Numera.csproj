<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package Identity & Metadata -->
    <Version>1.0.0</Version>
    <Authors>Dave Rayment</Authors>
    <Copyright>Copyright (c) 2026 Dave Rayment</Copyright>
    <Description>Lightweight mathematical expression evaluator for .NET with exact integer arithmetic, base-10 decimal preservation, and double fallback.</Description>
    <PackageTags>calculator expression evaluator engine arithmetic math mathematics parser biginteger</PackageTags>
    <PackageProjectUrl>https://github.com/daverayment/Numera</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daverayment/Numera</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
    <PackageIcon>assets\FxGear128x128.png</PackageIcon>

    <!-- Consumer Experience & IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1572;CS1573</WarningsAsErrors>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\FxGear128x128.png" Pack="true" PackagePath="assets\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Numera.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
